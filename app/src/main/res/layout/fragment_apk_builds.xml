<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="#0B0B0F">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Android APK Builds"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:paddingBottom="6dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Generated APK files"
        android:textColor="#888888"
        android:textSize="14sp"
        android:paddingBottom="18dp"/>

    <TextView
        android:id="@+id/emptyApkText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No APK builds yet.\nBuild an Android APK from a project."
        android:textColor="#888888"
        android:textSize="15sp"
        android:gravity="center"
        android:padding="40dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/apkBuildContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

    </ScrollView>

</LinearLayout>