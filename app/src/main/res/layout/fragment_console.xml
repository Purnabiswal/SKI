<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="#0B0F19">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Console" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="12dp" android:background="@drawable/bg_editor" android:padding="14dp">
        <TextView android:id="@+id/consoleText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#B8C0D1" android:fontFamily="monospace"/>
    </ScrollView>
</LinearLayout>
