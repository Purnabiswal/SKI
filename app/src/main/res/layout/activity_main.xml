<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0B0F19">
    <FrameLayout
        android:id="@+id/fragmentContainer" android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <LinearLayout
        android:id="@+id/bottomBar" android:layout_width="0dp" android:layout_height="72dp"
        android:layout_margin="10dp" android:padding="6dp" android:background="@drawable/bg_bottom"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView android:id="@+id/navCode" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:text="⌘
Code" android:textColor="#FFFFFF"/>
        <TextView android:id="@+id/navProjects" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:text="▣
Projects" android:textColor="#8D96AA"/>
        <TextView android:id="@+id/navConsole" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:text="›_
Console" android:textColor="#8D96AA"/>
        <TextView android:id="@+id/navSettings" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:text="⚙
Settings" android:textColor="#8D96AA"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
